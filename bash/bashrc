# bash/bashrc - Debian / bash configuration.
# Sourced from your existing ~/.bashrc by an include block that install.sh
# appends (your original file is backed up, never replaced). Don't symlink
# ~/.bashrc to this file: the include block is what loads it.

# The OSH_* / completions / aliases / plugins variables below are read by
# oh-my-bash.sh, not by this file.
# shellcheck disable=SC2034

# If not running interactively, don't do anything.
case $- in
  *i*) ;;
  *) return ;;
esac

# Never load this file from inside itself (e.g. ~/.bashrc symlinked here and
# the include block appended to it) - that recursion hangs every new shell.
# BASH_SOURCE is the stack of files being sourced; checking it (rather than
# setting a flag) still lets `. ~/.bashrc` reload everything normally.
for _dotfiles_src in "${BASH_SOURCE[@]:1}"; do
  if [ "$_dotfiles_src" -ef "${BASH_SOURCE[0]}" ]; then unset _dotfiles_src; return 0; fi
done
unset _dotfiles_src

# Location of the dotfiles checkout. The include block install.sh adds to your
# ~/.bashrc sets it; after moving the checkout, re-run `./install.sh --link`.
export DOTFILES="${DOTFILES:-$HOME/.dotfiles}"

# --- Bash-specific options ---------------------------------------------------
shopt -s histappend       # append to history, don't overwrite
shopt -s checkwinsize     # update LINES/COLUMNS after each command
shopt -s globstar 2>/dev/null  # ** recursive globbing
HISTCONTROL=ignoreboth    # no duplicate lines or lines starting with space

# --- Oh My Bash --------------------------------------------------------------
# Framework lives in ~/.oh-my-bash (cloned by install.sh). It owns the prompt
# (agnoster theme) and completion.
#
# We load no alias/plugin modules here, but Oh My Bash's core still defines a
# few (ll, la, cd...), so shell/common.sh loads our aliases *after* this block
# to make sure ours win. Completion only.
#
# Skipped when your own ~/.bashrc already loaded Oh My Bash (OMB_VERSION is
# set; your theme/plugin settings are kept), or when you set
# DOTFILES_NO_FRAMEWORK=1 above the include block, e.g. to keep starship or
# bash-it as your prompt.
if [ -z "${OMB_VERSION:-}" ] && [ -z "${DOTFILES_NO_FRAMEWORK:-}" ] \
    && [ -r "$HOME/.oh-my-bash/oh-my-bash.sh" ]; then
  export OSH="$HOME/.oh-my-bash"
  OSH_THEME="agnoster"                 # needs a Powerline/Nerd font to render
  DISABLE_AUTO_UPDATE="true"
  completions=(git ssh)
  aliases=()
  plugins=()
  source "$OSH/oh-my-bash.sh"
  # Only read while oh-my-bash.sh loads; don't leave such generic names behind.
  unset completions aliases plugins
fi

# --- Shared configuration (aliases, exports, functions, tooling) -------------
if [ -r "$DOTFILES/shell/common.sh" ]; then . "$DOTFILES/shell/common.sh"; fi
